#!/bin/sh
# Vault contract check. Install once per clone with:
#
#     git config core.hooksPath scripts
#
# Git then runs this file in place. There is no copy in .git/hooks/ to drift.
#
# The cross-vault backlink backlog is burnt down deliberately, not per-commit,
# so it is excluded here. Run
# `npm run vault:check -- --rule backlink` when you want to work on it.
#
# Python is found through scripts/py.js, not a bare `python`. On Windows a bare
# `python` can resolve to the Microsoft Store stub, which prints "Python was
# not found" even when Python is installed.
#
# To commit past this once: git commit --no-verify

# `stale` is deliberately absent: a note going 3 months without an update is a
# study signal for HOME.md, not a reason to block a commit.
RULES="--rule status --rule frontmatter --rule tags --rule index --rule readme \
--rule link --rule lab --rule sources --rule history --rule format --rule naming \
--rule flashcards"

# shellcheck disable=SC2086
if ! node scripts/py.js scripts/vault.py check $RULES --quiet; then
    echo
    echo "vault check failed — see above."
    echo "  details:  npm run vault:check -- --rule NAME"
    echo "  bypass:   git commit --no-verify"
    exit 1
fi
