filters:
  and:
    - 'file.hasProperty("format")'
    - 'format != "cards"'
    - 'format != "dashboard"'
views:
  - type: table
    name: All topics
    order:
      - file.name
      - vault
      - area
      - status
      - gaps
      - org_checks
      - updated
    sort:
      - property: vault
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Open gaps
    filters:
      and:
        - 'gaps > 0'
    order:
      - file.name
      - vault
      - gaps
      - level
    sort:
      - property: gaps
        direction: DESC
  - type: table
    name: Confirm in org
    filters:
      and:
        - 'org_checks > 0'
    order:
      - file.name
      - vault
      - org_checks
    sort:
      - property: org_checks
        direction: DESC
  - type: table
    name: Currency warnings
    filters:
      and:
        - 'tags.contains("currency-warning")'
    order:
      - file.name
      - vault
      - area
      - updated
    sort:
      - property: updated
        direction: ASC
  - type: table
    name: New since 2024
    filters:
      and:
        - 'tags.contains("currency-new")'
    order:
      - file.name
      - vault
      - area
      - updated
  - type: table
    name: Oldest first
    filters:
      and:
        - 'file.hasProperty("updated")'
    order:
      - file.name
      - vault
      - updated
      - status
    sort:
      - property: updated
        direction: ASC
