#!/bin/sh
# Vault contract check. Install with:
#
#     cp scripts/pre-commit .git/hooks/pre-commit
#
# The backlink backlog is hundreds of findings deep and is burnt down
# deliberately, not per-commit, so it is excluded here. Run
# `python scripts/vault.py check --rule backlink` when you want to work on it.
#
# To commit past this once: git commit --no-verify

# `stale` is deliberately absent: a note going 3 months without an update is a
# study signal for HOME.md, not a reason to block a commit.
RULES="--rule status --rule frontmatter --rule tags --rule index --rule readme \
--rule link --rule lab --rule sources --rule history --rule format --rule naming"

# shellcheck disable=SC2086
if ! python scripts/vault.py check $RULES --quiet; then
    echo
    echo "vault check failed — see above."
    echo "  details:  python scripts/vault.py check <--rule NAME>"
    echo "  bypass:   git commit --no-verify"
    exit 1
fi
